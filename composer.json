{
  "name": "exelearning/nextcloud-exelearning",
  "description": "Preview and edit eXeLearning .elpx packages in Nextcloud",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    { "name": "eXeLearning", "email": "dev@exelearning.net" }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "OCA\\ExeLearning\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\ExeLearning\\Tests\\": "tests/Unit/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration tests/phpunit.xml",
    "test:unit": "phpunit --configuration tests/phpunit.xml --testsuite unit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    }
  }
}
