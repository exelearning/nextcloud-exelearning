{
  "name": "nextcloud-exelearning",
  "version": "0.0.0-alpha",
  "description": "Preview and edit eXeLearning .elpx packages in Nextcloud Files",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "lint": "eslint --max-warnings 0 src",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/files": "^4.1.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.2.0",
    "fflate": "^0.8.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/vite-config": "^2.5.4",
    "@types/node": "^26.6.1",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "sass": "^1.104.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "@vitest/coverage-v8": "^5.0.1"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^10.0.0 || ^11.0.0"
  }
}
