{
  "name": "nextcloud-exelearning",
  "version": "0.0.0-alpha",
  "description": "Preview and edit eXeLearning .elpx packages in Nextcloud Files",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --progress --config webpack.config.js",
    "dev": "cross-env NODE_ENV=development webpack --progress --config webpack.config.js",
    "watch": "cross-env NODE_ENV=development webpack --progress --watch --config webpack.config.js",
    "lint": "eslint --max-warnings 0 src",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/router": "^3.0.1",
    "fflate": "^0.8.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.11",
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "@types/node": "^26.2.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.4.11",
    "babel-loader": "^10.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.1",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.6",
    "sass": "^1.103.1",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "minimizer-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-loader": "^17.4.0",
    "vue-tsc": "^3.3.11",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^22.15.0 || ^24.0.0",
    "npm": "^10.0.0 || ^11.0.0"
  }
}
